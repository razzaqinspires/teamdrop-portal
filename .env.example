# Server
NODE_ENV=development
PORT=3000
APP_NAME=TEAMDROP
APP_TAGLINE=Private Team Workspace

# Access codes: use long, unique random strings. Never share ADMIN_PASSWORD with the team.
TEAM_UPLOAD_CODE=replace-with-a-long-random-team-code
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-admin-password
SESSION_SECRET=replace-with-at-least-64-random-characters

# Whiskay Bot (Baileys) private document relay
# Keep this endpoint private; localhost is best when portal and bot share one VPS.
WHISKAY_BOT_WEBHOOK_URL=http://127.0.0.1:8787/webhooks/teamdrop/document
# Must exactly match TEAMDROP_WEBHOOK_SECRET in Whiskay Bot .env.
WHISKAY_BOT_WEBHOOK_TOKEN=

# Upload and retention
MAX_FILE_MB=50
RETENTION_DAYS=14
UPLOAD_DIR=./uploads
DATA_DIR=./data
